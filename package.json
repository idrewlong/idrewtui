{
  "name": "idrewlong-com",
  "version": "2.0.0",
  "private": true,
  "description": "idrewlong.com v2 \u2014 terminal-UI styled portfolio",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "node scripts/fetch-github.mjs && node scripts/generate-themes.mjs && nuxt generate && node scripts/finalize-static.mjs",
    "generate-themes": "node scripts/generate-themes.mjs",
    "fetch-github": "node scripts/fetch-github.mjs",
    "lighthouse": "lhci autorun",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/generate-themes.mjs && nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11",
    "@lhci/cli": "^0.15.1"
  }
}
